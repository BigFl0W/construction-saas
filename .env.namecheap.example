APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.com
APP_TIMEZONE=Africa/Lagos
SITE_NAME="TPV Construction and Services LTD"

DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpanel_db_name
DB_USER=cpanel_db_user
